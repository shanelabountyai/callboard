// Callboard's own tables (clone-owned). The object model is in the PRD doc (NEXT.md links it).
// Every row carries orgId (spec §6) and every query spreads inOrg(ctx) (spec §7b rule 2), including
// children whose parent already scopes them: one rule, no exceptions to remember.

enum PersonKind {
  employee
  volunteer
}

enum EventStatus {
  draft
  staffing
  confirmed
  live
  closed
}

/// What happened on a shift (PRD 6). Pre-filled from check-in data; the lead's review can overrule it.
enum ReviewOutcome {
  showed
  late
  no_show
  left_early
}

enum AssignmentStatus {
  invited
  confirmed
  declined
  released
}

/// Anyone who can be staffed: an employee from any department or a volunteer. Never needs a User.
model Person {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  mobile      String // E.164; the SMS thread and the magic link are tied to it
  email       String?
  kind        PersonKind
  department  String       @default("")
  notes       String       @default("") // internal: never rendered on the person's own page
  smsOptOut   Boolean      @default(false)
  tierOverride Int? // 1..3 set by hand; null = the tier computed from history (src/lib/review.ts)
  tierNote    String       @default("") // why it was set by hand; never rendered on the person's own page
  wantsBackAt DateTime?    @db.Timestamptz(6) // tapped "count me in next time" on a thank-you (PRD 6); the Staff list puts them first
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  assignments Assignment[]
  links       PersonLink[]
  leadOf      Aor[]        @relation("AorLead")
  deputyOf    Aor[]        @relation("AorDeputy")
  alerts      Alert[]
  broadcasts  BroadcastRecipient[]

  @@unique([orgId, mobile])
  @@index([orgId, name])
}

model Event {
  id            String         @id @default(uuid()) @db.Uuid
  orgId         String         @db.Uuid
  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  venue         String         @default("")
  timezone      String         @default("America/Chicago") // IANA; shift times are entered and shown in it
  status        EventStatus    @default(draft)
  callOffsetMin Int            @default(45) // call time before shift start, the default for new shifts
  graceMin      Int            @default(15) // no-show grace after call time; a position can override (PRD 5)
  emergencyContact String      @default("") // venue security / medical; shown first on a medical or security help request
  closedAt      DateTime?      @db.Timestamptz(6) // first time the status became closed; the review clock starts here (PRD 6)
  reviewAskedAt DateTime?      @db.Timestamptz(6) // the planner was asked to finish or waive the reviews still open after 7 days
  // The rest of the rule set (PRD 6, src/lib/rules.ts). An event holds its own value of every rule: it starts as
  // the org's standard, follows a change to the standard while it is being planned, and is frozen once live.
  overbookPct   Int            @default(20) // the default for new shifts
  stepMin       Int            @default(10) // a no-show alert waits this long at each step of the chain
  helpStepMin   Int            @default(5)
  nudgeDays     Int            @default(7) // the first reminder to the unconfirmed; the pack is always the day before
  breaks        String         @default("")
  minors        String         @default("")
  moves         String         @default("") // who can move whom
  thanks        String         @default("") // the thank-you sent at close; blank = the built-in one
  // An event template (PRD 6) is an event nobody staffs: the same editor, copied into each event started from it.
  isTemplate    Boolean        @default(false)
  attendanceBand String        @default("")
  templateId    String?        @db.Uuid // the template this event was started from; a copy, never a link
  template      Event?         @relation("StartedFrom", fields: [templateId], references: [id], onDelete: SetNull)
  startedFrom   Event[]        @relation("StartedFrom")
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  days          EventDay[]
  aors          Aor[]
  areas         Area[]
  positions     Position[]
  shifts        Shift[]
  assignments   Assignment[]
  links         PersonLink[]
  runOfShow     RunOfShowRow[]
  alerts        Alert[]
  broadcasts    Broadcast[]
  reviews       Review[]
  areaReviews   AreaReview[]

  @@index([orgId, createdAt])
}

model EventDay {
  id      String   @id @default(uuid()) @db.Uuid
  orgId   String   @db.Uuid
  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId String   @db.Uuid
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  shifts  Shift[]

  @@unique([eventId, date])
}

/// Area of responsibility: the cluster of areas one lead owns (PRD 2).
model Aor {
  id           String  @id @default(uuid()) @db.Uuid
  orgId        String  @db.Uuid
  org          Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId      String  @db.Uuid
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  color        String  @default("#4f46e5")
  radioChannel String  @default("")
  leadId       String? @db.Uuid
  lead         Person? @relation("AorLead", fields: [leadId], references: [id], onDelete: SetNull)
  deputyId     String? @db.Uuid
  deputy       Person? @relation("AorDeputy", fields: [deputyId], references: [id], onDelete: SetNull)
  areas        Area[]
  alerts       Alert[]

  @@index([eventId])
}

model Area {
  id        String     @id @default(uuid()) @db.Uuid
  orgId     String     @db.Uuid
  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId   String     @db.Uuid
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  aorId     String?    @db.Uuid // null = ungrouped, rolls up to the planner
  aor       Aor?       @relation(fields: [aorId], references: [id], onDelete: SetNull)
  name      String
  location  String     @default("")
  playbookId String?   @db.Uuid // one version of a library playbook; repointed like a card while the event is planned
  playbook  Playbook?  @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  positions Position[]
  review    AreaReview?

  @@index([eventId])
  @@index([playbookId])
}

model Position {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @db.Uuid
  org             Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId         String  @db.Uuid
  event           Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  areaId          String  @db.Uuid
  area            Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name            String
  minHeadcount    Int     @default(1) // the number that breaks the event
  targetHeadcount Int     @default(1)
  uniform         String  @default("")
  brief           String  @default("") // notes for this event only; the reusable part is the card
  cardId          String? @db.Uuid // one version of a library card; an edit to the library repoints only events not yet live
  card            PositionCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  graceMin        Int? // no-show grace in minutes; null = the event's default (PRD 5: doors 5, floaters 20)
  isFloat         Boolean @default(false) // the float pool: people here can be deployed to a red cell on the day
  shifts          Shift[]

  @@index([areaId])
  @@index([cardId])
}

model Shift {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  org         Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId     String       @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  positionId  String       @db.Uuid
  position    Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  dayId       String       @db.Uuid
  day         EventDay     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  callAt      DateTime     @db.Timestamptz(6) // all no-show logic keys off this, never startAt
  startAt     DateTime     @db.Timestamptz(6)
  endAt       DateTime     @db.Timestamptz(6)
  needed      Int
  overbookPct Int          @default(20)
  assignments Assignment[]

  @@index([eventId, dayId])
  @@index([positionId])
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  orgId         String           @db.Uuid
  org           Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId       String           @db.Uuid
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shiftId       String           @db.Uuid
  shift         Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  personId      String           @db.Uuid
  person        Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  status        AssignmentStatus @default(invited)
  respondedAt   DateTime?        @db.Timestamptz(6)
  declineReason String           @default("")
  t7SentAt      DateTime?        @db.Timestamptz(6) // reminder bookkeeping (cron-jobs.ts)
  t1SentAt      DateTime?        @db.Timestamptz(6)
  // Day of (PRD 5). checkedInAt is the device time of the tap; syncedAt is when the server heard of it.
  checkedInAt   DateTime?        @db.Timestamptz(6)
  checkInMethod String           @default("") // lead | self | sms | planner
  checkInSyncedAt DateTime?      @db.Timestamptz(6)
  checkedOutAt  DateTime?        @db.Timestamptz(6)
  checkOutMethod String          @default("") // lead | self | sms | planner | auto (shift end + 60 min, flagged)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  alerts        Alert[]
  review        Review?

  @@unique([shiftId, personId])
  @@index([personId])
  @@index([eventId, status])
}

/// One magic link per person per event (PRD 3). Only the sha256 is stored (INV-07).
model PersonLink {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId  String   @db.Uuid
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(6) // event end + 7 days; no immortal links
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([eventId, personId])
}

/// Mirror of the run of show kept in Excel or Smartsheet (PRD 1). Never edited here.
model RunOfShowRow {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @db.Uuid
  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId   String @db.Uuid
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceKey String // "time|cue" from the sheet, or "manual:<uuid>" for a hand-added line
  manual    Boolean @default(false) // hand-added here; a re-import never replaces these
  at        String // "09:30" as written in the sheet; a timeline, not a timestamp
  cue       String
  area      String @default("")
  owner     String @default("")
  sortOrder Int

  @@unique([eventId, sourceKey])
}

enum AlertKind {
  no_show
  help
}

/// A day-of alert (PRD 5). Owned by the AoR's chain: step 0 = lead, 1 = deputy, 2 = planner.
/// It escalates one step every 10 minutes (5 for help) until resolved; a planner sees step 2 on the board.
model Alert {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @db.Uuid
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId      String    @db.Uuid
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind         AlertKind
  severity     Int       @default(2) // 1 low, 2 medium, 3 high (medical or security)
  personId     String    @db.Uuid
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  assignmentId String?   @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  aorId        String?   @db.Uuid // the chain; null = straight to the planner
  aor          Aor?      @relation(fields: [aorId], references: [id], onDelete: SetNull)
  step         Int       @default(0)
  steppedAt    DateTime  @default(now()) @db.Timestamptz(6)
  category     String    @default("") // help: supplies | vip | relief | medical | security | other
  note         String    @default("")
  openedAt     DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt   DateTime? @db.Timestamptz(6)
  resolution   String    @default("")

  @@index([assignmentId, resolvedAt]) // the sweep checks for an open one before raising; a NULL-safe unique cannot
  @@index([eventId, resolvedAt])
}

/// A targeted send (PRD 4): one message to an audience, with optional one-tap "Got it".
model Broadcast {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId     String   @db.Uuid
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience    String // human label of the picker choice, kept for the log
  body        String
  requiresAck Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  recipients  BroadcastRecipient[]

  @@index([eventId, createdAt])
}

model BroadcastRecipient {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  broadcastId String    @db.Uuid
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  personId    String    @db.Uuid
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  outboxId    String?   @db.Uuid // the SMS row, for delivered / failed per person (swept after a week)
  ackedAt     DateTime? @db.Timestamptz(6)

  @@unique([broadcastId, personId])
  @@index([personId, ackedAt])
}

/// The position card library (PRD 6): what the job is, written once and reused. One row per version;
/// versions are linear per (org, key), so two planners saving at once cannot both win. What to wear,
/// where to report, the lead and the call time are slots filled from the position, area and shift.
model PositionCard {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @db.Uuid
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key        String // slug of the first title; never changes, so a rename keeps its history
  version    Int
  title      String
  purpose    String     @default("") // one line
  duties     String     @default("") // what you do: one per line, five at most
  situations String     @default("") // what to do if: one per line, five at most
  never      String     @default("") // what you must never do
  demands    String     @default("") // skills and physical demands
  minAge     Int? // age restriction; planner-facing
  changedBy  String     @db.Uuid // the User who saved this version; no foreign key, like the audit log
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  positions  Position[]

  @@unique([orgId, key, version])
}

/// A lead's (or planner's) word on one assignment after the event (PRD 6). Optional per person.
model Review {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String        @db.Uuid
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId      String        @db.Uuid
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignmentId String        @unique @db.Uuid
  assignment   Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  outcome      ReviewOutcome
  rehire       Boolean? // would you have them back; null = no opinion
  note         String        @default("")
  by           String // the reviewer's name as it was, so the row reads the same after they leave
  at           DateTime      @db.Timestamptz(6)

  @@index([eventId])
}

/// The three questions per area (PRD 6), required before the event's review is complete unless the planner waives it.
model AreaReview {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId      String   @db.Uuid
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  areaId       String   @unique @db.Uuid
  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  understaffed String   @default("") // when were you short
  overstaffed  String   @default("") // when did you have too many
  wentWrong    String   @default("") // what went wrong
  waived       Boolean  @default(false)
  waiveNote    String   @default("")
  by           String
  at           DateTime @db.Timestamptz(6)

  @@index([eventId])
}

/// The area playbook library (PRD 6): how an area is run, written once and reused. Versioned like a card.
model Playbook {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key           String
  version       Int
  title         String
  // ponytail: staffing is one line per position and hour ("Greeter 8 to 9am: min 6, target 8"), read by people.
  // Make it rows when proposed edits (PRD 6 P1) need to change a number.
  staffing      String   @default("")
  callOffsetMin Int? // planner-facing; blank = the event's
  breakPlan     String   @default("")
  floatPlan     String   @default("")
  equipment     String   @default("") // one per line
  setup         String   @default("") // checklist, one per line
  close         String   @default("") // checklist, one per line
  failurePoints String   @default("") // known failure points, one per line
  changedBy     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  areas         Area[]

  @@unique([orgId, key, version])
}

/// The org's standard rules (PRD 6): one row per org, made with the defaults the first time it is read.
model OrgRules {
  orgId         String   @id @db.Uuid
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  graceMin      Int      @default(15)
  callOffsetMin Int      @default(45)
  overbookPct   Int      @default(20)
  stepMin       Int      @default(10)
  helpStepMin   Int      @default(5)
  nudgeDays     Int      @default(7)
  breaks        String   @default("")
  minors        String   @default("")
  moves         String   @default("")
  thanks        String   @default("")
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
}
